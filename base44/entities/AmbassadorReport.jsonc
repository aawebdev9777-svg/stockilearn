{
  "name": "AmbassadorReport",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "ambassador_application",
        "change_report"
      ],
      "description": "Whether this is an ambassador application or a change request report"
    },
    "title": {
      "type": "string",
      "description": "Short summary of the report or application"
    },
    "description": {
      "type": "string",
      "description": "Full details of what the user wants changed or why they want to be an ambassador"
    },
    "category": {
      "type": "string",
      "enum": [
        "bug",
        "feature",
        "content",
        "gamification",
        "design",
        "other"
      ],
      "default": "other"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "reviewing",
        "accepted",
        "rejected",
        "implemented"
      ],
      "default": "pending"
    },
    "app_user_id": {
      "type": "string",
      "description": "The AppUser id of the submitter (custom-auth user, since platform User differs)"
    },
    "username": {
      "type": "string",
      "description": "Submitter username for quick display"
    },
    "admin_note": {
      "type": "string",
      "description": "Optional note left by an admin when approving/rejecting"
    }
  },
  "required": [
    "type",
    "title",
    "description"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}