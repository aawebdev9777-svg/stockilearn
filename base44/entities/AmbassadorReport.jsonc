{
  "name": "AmbassadorReport",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "ambassador_application",
        "change_report"
      ],
      "description": "Whether this is an ambassador application or a change request report"
    },
    "title": {
      "type": "string",
      "description": "Short summary of the report or application"
    },
    "description": {
      "type": "string",
      "description": "Full details of what the user wants changed or why they want to be an ambassador"
    },
    "category": {
      "type": "string",
      "enum": [
        "bug",
        "feature",
        "content",
        "gamification",
        "design",
        "other"
      ],
      "default": "other"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "reviewing",
        "accepted",
        "rejected",
        "implemented"
      ],
      "default": "pending"
    }
  },
  "required": [
    "type",
    "title",
    "description"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}